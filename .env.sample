# Example configuration for the standalone decision-model scripts.
# Use a local .env file for real endpoints and keys; never commit credentials.

# Azure Decision-1, authenticated with Azure Entra credentials.
AZURE_ENDPOINT=https://your-resource.services.ai.azure.com/providers/microsoft/v1/systemone
DEPLOYMENT_NAME=Decision-1

# General-purpose Azure LLM used for the structured-output comparison.
GPT_AZUREENDPOINT=https://your-resource.services.ai.azure.com/openai/v1
GPT_DEPLOYMENT_NAME=gpt-6.1-sol-1

# Native Jev decisions through the TypeSafe SDK.
JEV_ENDPOINT=https://your-endpoint.typesafe.ai/v1/systemone
JEV_DEPLOYMENT_NAME=jev-latest
JEV_KEY=

# Native OpenAI Decisions API.
OPENAI_ENDPOINT=https://api.openai.com/v1/decisions
OPENAI_KEY=
OPENAI_DEPLOYMENT_NAME=gpt-6-luna

# Local Ollama with a native decision-capable model.
OLLAMA_ENDPOINT=http://localhost:11434/v1/systemone
OLLAMA_DEPLOYMENT_NAME=laya:latest